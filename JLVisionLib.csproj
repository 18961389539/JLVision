<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <AssemblyName>JLVisionLib</AssemblyName>

    <RootNamespace />

    <TargetFramework>netstandard2.0</TargetFramework>

    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>

    <LangVersion>14.0</LangVersion>

    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

  </PropertyGroup>



  <!-- NuGet 打包元数据（包内包含托管包装 JLVisionLib.dll 与原生核心 JLVisionCore.dll） -->

  <PropertyGroup>

    <IsPackable>true</IsPackable>

    <PackageId>JLVisionLib</PackageId>

    <VersionPrefix>1.0.0</VersionPrefix>

    <Authors>JLVision</Authors>

    <Description>Headless .NET vision library (HALCON-style operators, single managed assembly) with the native x64 core runtime bundled for Windows.</Description>

    <PackageTags>vision;machine-vision;image-processing;native;interop</PackageTags>

    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>

    <PackageProjectUrl>https://github.com/18961389539/JLVision</PackageProjectUrl>

    <RepositoryUrl>https://github.com/18961389539/JLVision.git</RepositoryUrl>

    <RepositoryType>git</RepositoryType>

  </PropertyGroup>



  <ItemGroup>

    <Compile Include="Properties\AssemblyInfo.cs" />

    <Compile Include="JLVisionLib.Runtime\**\*.cs" Exclude="JLVisionLib.Runtime\obj\**;JLVisionLib.Runtime\bin\**;JLVisionLib.Runtime\Properties\AssemblyInfo.cs" />

  </ItemGroup>



  <ItemGroup>
    <Content Include="Libs\JLVisionCore.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>JLVisionCore.dll</Link>
      <!-- 原生核心库按 win-x64 运行时资产随包分发 -->
      <Pack>true</Pack>
      <PackagePath>runtimes\win-x64\native\</PackagePath>
    </Content>
  </ItemGroup>



  <!-- 消费方构建时把原生核心库复制到输出目录，保证 DllImport("JLVisionCore") 可解析 -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Update="buildTransitive\JLVisionLib.targets" Pack="true" PackagePath="buildTransitive\JLVisionLib.targets" Visible="false" />
  </ItemGroup>



  <ItemGroup>

    <PackageReference Include="Obfuscar" Version="2.2.49">

      <PrivateAssets>all</PrivateAssets>

      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>

    </PackageReference>

  </ItemGroup>



  <PropertyGroup>

    <ObfuscarConfig>$(MSBuildProjectDirectory)\obfuscar.xml</ObfuscarConfig>

    <DistDir>$(MSBuildProjectDirectory)\dist\$(Configuration)\</DistDir>

  </PropertyGroup>



  <Target Name="Obfuscate" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">

    <PropertyGroup>

      <ObfuscarTool>$(NuGetPackageRoot)obfuscar\2.2.49\tools\Obfuscar.Console.exe</ObfuscarTool>

      <ObfuscarOutPath>$(TargetDir)obfuscated\</ObfuscarOutPath>

    </PropertyGroup>

    <MakeDir Directories="$(ObfuscarOutPath)" />

    <Exec Command="&quot;$(ObfuscarTool)&quot; &quot;$(ObfuscarConfig)&quot;" WorkingDirectory="$(TargetDir)" />

    <Copy SourceFiles="$(ObfuscarOutPath)JLVisionLib.dll" DestinationFiles="$(TargetDir)JLVisionLib.dll" />

    <Copy SourceFiles="$(ObfuscarOutPath)JLVisionLib.pdb" DestinationFiles="$(TargetDir)JLVisionLib.pdb" Condition="Exists('$(ObfuscarOutPath)JLVisionLib.pdb')" />

  </Target>



  <Target Name="PublishDist" AfterTargets="Build">

    <MakeDir Directories="$(DistDir)" />

    <ItemGroup>

      <_DistFiles Include="$(TargetDir)JLVisionLib.dll" />

      <_DistFiles Include="$(TargetDir)JLVisionLib.pdb" Condition="Exists('$(TargetDir)JLVisionLib.pdb')" />

      <_DistFiles Include="$(TargetDir)JLVisionCore.dll" />

    </ItemGroup>

    <Copy SourceFiles="@(_DistFiles)" DestinationFolder="$(DistDir)" SkipUnchangedFiles="true" />

    <Message Importance="high" Text="Published to $(DistDir)" />

  </Target>

</Project>

